# ---------- Database ----------
# Leave empty to use the embedded PGlite (PostgreSQL + pgvector in-process, stored in ./data/pglite).
# For Supabase / any PostgreSQL with pgvector, set the connection string:
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=
# Optional: where the embedded PGlite database lives (default ./data/pglite)
PGLITE_DATA_DIR=

# ---------- Auth ----------
# Secret used to sign session cookies. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# ---------- System AI keys (optional; users may also BYOK in Settings → AI Providers) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional custom base URLs for system keys (proxies / OpenAI-compatible gateways), e.g. OPENAI_BASE_URL=https://gateway.example/v1
OPENAI_BASE_URL=

# Default system models (used when a workspace has no configured providers)
SYSTEM_DEFAULT_PROVIDER=openai
SYSTEM_DEFAULT_MODEL=gpt-4o-mini
SYSTEM_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Storage ----------
# Uploaded originals are stored under ./data/uploads by default.
UPLOAD_DIR=./data/uploads

# ---------- Platform credits (system keys) ----------
# New workspaces receive this many USD-equivalent credits for system-key usage.
SIGNUP_FREE_CREDITS=2
# Multiplier applied to estimated model cost when billing platform credits.
SYSTEM_CREDITS_MARKUP=1.5
# Comma-separated emails allowed to grant credits from Settings → Billing.
BILLING_ADMIN_EMAILS=

# ---------- Publishing ----------
# Auto-publish scheduler (runs inside the Node process). Set DISABLE_SCHEDULER=1 to turn off.
SCHEDULER_INTERVAL_MS=60000
